{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "linear": {
      "enabled": false
    },
    "atlassian": {
      "enabled": false
    },
    "linear_workspace_slug": {
      "type": "remote",
      "url": "https://mcp.linear.app/mcp",
      "enabled": true,
      "oauth": false,
      "headers": {
        "Authorization": "Bearer {env:LINEAR_WORKSPACE_TOKEN}"
      },
      "timeout": 15000
    }
  }
}
