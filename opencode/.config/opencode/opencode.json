{
  "$schema": "https://opencode.ai/config.json",
  "model": "openai/gpt-5.6-sol",
  "small_model": "openai/gpt-5.6-luna",
  "default_agent": "lead",
  "enabled_providers": ["openai"],
  "share": "disabled",
  "snapshot": true,
  "lsp": true,
  "compaction": {
    "auto": true,
    "prune": false,
    "tail_turns": 4,
    "reserved": 10000
  },
  "watcher": {
    "ignore": [
      "**/.git/**",
      "**/node_modules/**",
      "**/dist/**",
      "**/build/**",
      "**/coverage/**",
      "**/.cache/**"
    ]
  },
  "mcp": {
    "linear": {
      "type": "remote",
      "url": "https://mcp.linear.app/mcp",
      "enabled": false,
      "timeout": 15000
    },
    "atlassian": {
      "type": "remote",
      "url": "https://mcp.atlassian.com/v1/mcp",
      "enabled": false,
      "timeout": 15000
    },
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true,
      "timeout": 15000
    },
    "gh_grep": {
      "type": "remote",
      "url": "https://mcp.grep.app",
      "enabled": true,
      "timeout": 15000
    }
  },
  "permission": {
    "read": {
      "*": "allow",
      "**/.env": "deny",
      "**/.env.*": "deny",
      "**/*credentials*": "deny",
      "**/*secret*": "ask"
    },
    "edit": "ask",
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "lsp": "allow",
    "bash": {
      "*": "ask",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git branch*": "allow",
      "git rev-parse*": "allow",
      "git push*": "ask",
      "git reset*": "deny",
      "git clean*": "deny",
      "git checkout --*": "deny",
      "sudo *": "deny",
      "rm -rf *": "deny"
    },
    "task": "deny",
    "external_directory": "ask",
    "todowrite": "allow",
    "question": "allow",
    "webfetch": "ask",
    "websearch": "ask",
    "skill": "allow",
    "doom_loop": "ask",
    "linear_*": "deny",
    "atlassian_*": "deny",
    "context7_*": "deny",
    "gh_grep_*": "deny"
  }
}
